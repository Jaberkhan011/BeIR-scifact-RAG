# Dataset selection and local artifact locations
DATASET_NAME=scifact
DATA_ROOT=datasets
DB_ROOT=src/beir_scifact_rag/retrieval_db
EVALUATION_ROOT=evaluation_results

# Optional explicit paths. Leave unset to use DATA_ROOT/<DATASET_NAME>/.
# CORPUS_PATH=datasets/scifact/corpus.parquet
# QUESTIONS_PATH=datasets/scifact/questions.parquet
# QRELS_PATH=datasets/scifact/qrels.parquet
# DB_DIR=src/beir_scifact_rag/retrieval_db/scifact

# Models and retrieval settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=16
RERANK_CANDIDATE_K=50

# Evaluation settings
MIN_RELEVANT_DOCS=2
EVAL_QUERY_LIMIT=50

# Optional provider credentials for local experiments. Do not commit real values.
# GEMINI_API_KEY=
